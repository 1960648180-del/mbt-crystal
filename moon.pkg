// 包配置：本包是**库**（根包 = 库，这才是别人能 import 的形式）。
// 一个包只能是库或可执行程序，所以命令行程序单独放在 cmd/main。
//
//   string -> parse_double（把字符串转成小数）
//   math   -> cos（余弦函数）
//   double -> round（拼警告文字时四舍五入）
//   bio    -> vendor/crystal：分词这个"管道活"复用 BioSeqs 的实现
//             （它引号感知，比我们手动切字段干净；详见 cif.mbt 顶部说明）
import {
  "moonbitlang/core/string",
  "moonbitlang/core/math",
  "moonbitlang/core/double",
  "user/mbt-crystal/vendor/crystal" @bio,
}
